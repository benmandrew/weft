use flake

# nix-direnv caches the output of `nix print-dev-env`, which defines shellHook
# as a variable without ever running it. The PYTHONPATH and the WordNet symlink
# the shell depends on both live in that hook, so without this line they happen
# under `nix develop` and never under direnv. Running it here keeps one
# definition in flake.nix rather than a copy that drifts.
eval "$shellHook"
